FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// RTX 3090 x2 GPU 가속: GAMG + AmgX 연동 (AmgX 설치 시 자동 활성화)

// ─── UI 제어 변수 (Python에서 이 한 줄만 치환) ───────────────────────────
residualLevel   1e-03;

solvers
{
    p
    {
        // GPU AmgX 가속 사용 시: solver amgxSolver; (OpenFOAM-AMGx 플러그인 필요)
        solver          GAMG;
        tolerance       1e-7;
        relTol          0.01;
        smoother        GaussSeidel;
        nPreSweeps      0;
        nPostSweeps     2;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 10;
        agglomerator    faceAreaPair;
        mergeLevels     1;
    }

    "(U|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.01;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 2;
    consistent      yes;        // SIMPLEC 알고리즘 (수렴 가속)

    residualControl
    {
        p               $residualLevel;
        U               $residualLevel;
        "(k|omega)"     $residualLevel;
    }
}

relaxationFactors
{
    fields
    {
        p               0.3;
    }
    equations
    {
        U               0.7;
        k               0.7;
        omega           0.7;
    }
}

