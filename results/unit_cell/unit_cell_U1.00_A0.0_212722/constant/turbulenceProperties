FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType  RAS;

RAS
{
    // k-omega SST: 그물 주변 박리 유동에 최적화된 난류 모델
    RASModel        kOmegaSST;
    turbulence      on;
    printCoeffs     on;
}

