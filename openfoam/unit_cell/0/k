FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// 난류 운동 에너지 k
// k = 1.5 * (I * U)^2  여기서 I = 난류 강도(turbulence intensity) = 0.05

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 3.75e-3;   // k = 1.5*(0.05*1.0)^2 = 3.75e-3 m^2/s^2

boundaryField
{
    xMin
    {
        type            cyclicAMI;
    }
    xMax
    {
        type            cyclicAMI;
    }
    yMin
    {
        type            cyclicAMI;
    }
    yMax
    {
        type            cyclicAMI;
    }
    zMin
    {
        type            turbulentIntensityKineticEnergyInlet;
        intensity       0.05;
        value           uniform 3.75e-3;
    }
    zMax
    {
        type            zeroGradient;
    }
    netSurface
    {
        type            kqRWallFunction;
        value           uniform 3.75e-3;
    }
}

