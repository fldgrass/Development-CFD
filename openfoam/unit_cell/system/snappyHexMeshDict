FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// ─── UI 제어 변수 (Python에서 이 두 줄만 치환) ───────────────────────────
refineLevelMin  2;
refineLevelMax  3;

castellatedMesh true;
snap            true;
addLayers       true;   // v11: 경계층 프리즘 레이어(벤치마크·UC 검증 설정)

geometry
{
    // STL 파일명은 Python 스크립트에서 자동 치환됨
    // scale 0.001: Rhino3D에서 mm 단위로 내보낸 STL을 m으로 변환
    netSurface.stl
    {
        type    triSurfaceMesh;
        name    netSurface;
        scale   0.001;
    }
}

castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      10000000;
    minRefinementCells  10;
    maxLoadUnbalance    -1;     // -1 = balance 비활성화 (cyclic+소형도메인 segfault 방지)
    nCellsBetweenLevels 3;

    features
    (
        {
            file    "netSurface.eMesh";
            level   2;
        }
    );

    refinementSurfaces
    {
        netSurface
        {
            // 그물발 표면 정밀화 레벨 (UI에서 조절)
            level ($refineLevelMin $refineLevelMax);
            patchInfo
            {
                type    wall;
                inGroups (wall);
            }
        }
    }

    refinementRegions
    {
        netSurface
        {
            // distance 방식: 비밀폐(open) 그물 STL에서도 동작
            // (2e-3 3) = 표면 2mm 이내를 레벨 3으로 정밀화
            mode    distance;
            levels  ((2e-3 3));
        }
    }

    // 도메인 내부 점 (격자 내부 기준점)
    resolveFeatureAngle 30;

    locationInMesh (0 0 0);

    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch        3;
    tolerance           2.0;
    nSolveIter          30;
    nRelaxIter          5;
    nFeatureSnapIter    10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes       false;          // 절대 두께(m)
    layers
    {
        netSurface
        {
            nSurfaceLayers  4;
        }
    }
    expansionRatio          1.3;
    firstLayerThickness     3.0e-05;     // 첫 층 0.03mm (그물실 경계층 해상)
    minThickness            4.0e-06;
    nGrow                   0;
    featureAngle            60;
    nRelaxIter              5;
    nRelaxedIter            20;
    nSmoothSurfaceNormals   1;
    nSmoothNormals          3;
    nSmoothThickness        10;
    maxFaceThicknessRatio   0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle      90;
    nBufferCellsNoExtrude   0;
    nLayerIter              50;
}

meshQualityControls
{
    maxNonOrtho             65;
    maxBoundarySkewness     20;
    maxInternalSkewness     4;
    maxConcave              80;
    minVol                  1e-13;
    minTetQuality           1e-15;
    minArea                 -1;
    minTwist                0.02;
    minDeterminant          0.001;
    minFaceWeight           0.05;
    minVolRatio             0.01;
    minTriangleTwist        -1;
    nSmoothScale            4;
    errorReduction          0.75;
    // v11: 레이어 반복 후반(nRelaxedIter 이후)에 적용되는 완화 기준 —
    // 그물 교차점의 오목부에서 레이어 생존율을 높인다(커버리지 25%→73%).
    relaxed
    {
        maxNonOrtho             75;
        maxBoundarySkewness     25;
        maxInternalSkewness     8;
        maxConcave              90;
        minVol                  1e-15;
        minTetQuality           -1;
        minArea                 -1;
        minTwist                0.001;
        minDeterminant          1e-06;
        minFaceWeight           0.02;
        minVolRatio             0.005;
        minTriangleTwist        -1;
    }
}

writeFlags
(
    scalarLevels
);

mergeTolerance 1e-6;

// ************************************************************************* //
