FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// 단위 셀(Unit Cell) 배경 격자
// 그물발 직경(d) ≈ 1mm, 단위 셀 크기 = 메쉬 사이즈(a)
// 기본값: a = 20mm, 도메인 = 1셀 x 1셀 x 5셀 (유동 방향 z)
// Python 스크립트에서 $CELL_SIZE 변수를 치환하여 자동 조정

scale   0.001;   // mm → m 변환

// 단위 셀 크기 (mm 단위, Python에서 교체됨)
// CELL_SIZE_MM = 20
// DOMAIN: x[-10,10], y[-10,10], z[-50,50]

vertices
(
    (-10 -10 -50)   // 0
    ( 10 -10 -50)   // 1
    ( 10  10 -50)   // 2
    (-10  10 -50)   // 3
    (-10 -10  50)   // 4
    ( 10 -10  50)   // 5
    ( 10  10  50)   // 6
    (-10  10  50)   // 7
);

blocks
(
    // nx ny nz 셀 수 (snappyHexMesh용 배경격자, 비교적 거친 격자)
    hex (0 1 2 3 4 5 6 7) (20 20 100) simpleGrading (1 1 1)
);

edges ();

boundary
(
    zMin
    {
        type    patch;
        faces   ((0 3 2 1));
    }
    zMax
    {
        type    patch;
        faces   ((4 5 6 7));
    }
    xMin
    {
        // v11 addLayers 업그레이드: cyclic → cyclicAMI.
        // 그물선이 주기 경계를 관통할 때 레이어 절단이 결합면 순서를 깨는
        // getFaceOrder FATAL 을 회피(AMI 는 위상 결합이 없어 무관).
        type            cyclicAMI;
        neighbourPatch  xMax;
        transform       translational;
        separationVector (0.02 0 0);
        lowWeightCorrection 0.2;
        faces   ((0 4 7 3));
    }
    xMax
    {
        // v11 addLayers 업그레이드: cyclic → cyclicAMI.
        // 그물선이 주기 경계를 관통할 때 레이어 절단이 결합면 순서를 깨는
        // getFaceOrder FATAL 을 회피(AMI 는 위상 결합이 없어 무관).
        type            cyclicAMI;
        neighbourPatch  xMin;
        transform       translational;
        separationVector (-0.02 0 0);
        lowWeightCorrection 0.2;
        faces   ((1 2 6 5));
    }
    yMin
    {
        // v11 addLayers 업그레이드: cyclic → cyclicAMI.
        // 그물선이 주기 경계를 관통할 때 레이어 절단이 결합면 순서를 깨는
        // getFaceOrder FATAL 을 회피(AMI 는 위상 결합이 없어 무관).
        type            cyclicAMI;
        neighbourPatch  yMax;
        transform       translational;
        separationVector (0 0.02 0);
        lowWeightCorrection 0.2;
        faces   ((0 1 5 4));
    }
    yMax
    {
        // v11 addLayers 업그레이드: cyclic → cyclicAMI.
        // 그물선이 주기 경계를 관통할 때 레이어 절단이 결합면 순서를 깨는
        // getFaceOrder FATAL 을 회피(AMI 는 위상 결합이 없어 무관).
        type            cyclicAMI;
        neighbourPatch  yMin;
        transform       translational;
        separationVector (0 -0.02 0);
        lowWeightCorrection 0.2;
        faces   ((3 7 6 2));
    }
);

mergePatchPairs ();

